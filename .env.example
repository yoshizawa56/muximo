# Select a profile explicitly with `muximo --env local ...`, `--env stg ...`,
# or `--env prod ...`. The repository provides `.env.local` and `.env.stg`.
# Production uses built-in defaults and does not read `.env`.

# Optional shared state root. Component paths are always derived below it:
# <state-root>/<environment>/{muximod,web}/.
# MUXIMO_STATE_ROOT=/Users/you/.local/state/muximo

# The local and staging profile files define fixed component ports. Override
# these values only in a deliberately different profile.
# Components bind to loopback by default. An explicit private IP is supported
# for a deliberate LAN deployment; wildcard and public bind addresses are rejected.
# MUXIMO_MUXIMOD_HOST=192.168.1.20
# MUXIMO_WEB_HOST=192.168.1.20
# MUXIMO_MUXIMOD_PORT=4317
# MUXIMO_MUXIMOD_SERVE_PORT=8444
# MUXIMO_WEB_PORT=5227
# MUXIMO_WEB_SERVE_PORT=8449

# `local` defaults to push and `stg`/`prod` default to migrate. This is a
# profile setting, not a per-command daemon option.
# MUXIMO_SCHEMA_MODE=push

# Tailscale is queried for its current DNS name when this is omitted. A fixed
# machine-specific hostname may be supplied in an ignored shell environment.
# MUXIMO_TAILSCALE_HOSTNAME=your-machine.tailnet.ts.net
# TAILSCALE_BIN=tailscale

# Muximod configuration that is not derived from the selected environment.
# MUXIMOD_ALLOWED_ORIGINS=https://your-machine.tailnet.ts.net:8449
# MUXIMOD_WORKSPACE_ROOTS=/Users/you/work:/Users/you/projects
# MUXIMOD_TMUX_SOCKET=/Users/you/.local/state/muximo/tmux.sock
# MUXIMOD_MUXIMO_COMMAND=/absolute/path/to/muximo
# MUXIMO_LOG_LEVEL=info
# The muximod log is always derived as <state-root>/<environment>/muximod/muximod.log.

# Pairing accepts an explicit URL as a one-shot override:
# muximo --env local pair --muximod-base-url https://your-machine.tailnet.ts.net:8444
