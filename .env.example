# Each dev.ts loads this file. Explicit shell environment variables take
# precedence over values from .env. Portless provides the worktree-specific
# PORT and PORTLESS_URL values to the Web and muximod child processes.
# When using muximo-managed worktrees, register `.env` once with
# `muximo workspace update <workspace> --add-copy-pattern .env` so each
# worktree receives its own copy before dev.ts starts.

# Optional parent instance whose SQLite state is snapshotted into a worktree's
# MUXIMOD_INSTANCE_DIR on the first muximod dev start. The target state is not
# overwritten after it has been initialized.
# BASE_MUXIMOD_INSTANCE_DIR=/Users/you/.local/state/muximo/main

# `bun -F serve dev` starts the Portless Web and muximod processes and configures
# the fixed Tailscale routes. The defaults are HTTPS 443 for Web and HTTPS 8444
# for muximod.

# Optional fixed external port for the Web route.
# MUXIMO_WEB_SERVE_PORT=443

# Optional fixed external port for `muximo serve tailscale`.
# MUXIMO_SERVE_PORT=8444

# Optional convenience output. Tailscale status is queried automatically when
# this is omitted.
# MUXIMO_TAILSCALE_HOSTNAME=your-machine.tailnet.ts.net

# Explicit state values are only needed when running muximod without its dev
# entrypoint.
# MUXIMO_WORKTREE_ID=main
# MUXIMOD_INSTANCE_DIR=/Users/you/.local/state/muximo/main
# MUXIMOD_PORT=4317

# Web development overrides. The Web UI is served independently; it receives
# its muximod connection endpoint from pairing at runtime.
# VITE_ALLOWED_HOSTS=your-machine.tailnet.ts.net
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_PORT=5227

# Pairing/muximod overrides. `muximo pair` uses muximod-only Tailscale Serve by
# default; use `muximo pair --without-serve` for a local muximod endpoint.
# MUXIMOD_HOST=127.0.0.1
# MUXIMOD_PAIRING_BASE_URL=https://your-muximod-host.example
# MUXIMOD_WORKSPACE_ROOTS=/Users/you/work:/Users/you/projects
# MUXIMOD_TMUX_SOCKET=/Users/you/.local/state/muximo/tmux.sock
# MUXIMOD_MUXIMO_COMMAND=/absolute/path/to/muximo
# MUXIMO_LOG_LEVEL=info
# MUXIMO_LOG_FILE=/Users/you/.local/state/muximo/muximod.log
# TAILSCALE_BIN=tailscale
