# Select any profile explicitly with `muximo --env <name> ...`.
# The option loads an ignored `.env.<name>` from the source checkout. Use
# `mise profile` to generate one from a tracked `.env.<name>.example` recipe.
# Without `--env`, no profile file is loaded and application defaults are used.
# The repository's Bun entrypoints disable Bun's automatic `.env` loading before
# this selection.

# Optional shared state root. Component paths are always derived below it:
# <state-root>/<environment>/{muximod,web}/.
# MUXIMO_STATE_ROOT=/Users/you/.local/state/muximo

# Profile files are raw shared inputs. The CLI interprets
# MUXIMOD_* and MUXIMO_SCHEMA_MODE; Web interprets MUXIMO_WEB_* and VITE_*.
# Override these values only in a deliberately different profile.
# Components bind to loopback by default. An explicit private IP is supported
# for a deliberate LAN deployment; wildcard and public bind addresses are rejected.
# MUXIMO_MUXIMOD_HOST=192.168.1.20
# MUXIMO_WEB_HOST=192.168.1.20
# MUXIMO_MUXIMOD_PORT=4317
# MUXIMO_MUXIMOD_SERVE_PORT=8444
# MUXIMO_WEB_PORT=5227
# MUXIMO_WEB_SERVE_PORT=8449

# The CLI schema mode defaults to migrate for every profile. Set this explicitly
# when a profile is intended to use push; this is a profile setting, not a
# per-command daemon option.
# MUXIMO_SCHEMA_MODE=push

# Tailscale is queried for its current DNS name by `mise profile` when the
# Tailscale connection method is selected. The generated value is ignored by
# Git because it is machine-specific.
# MUXIMO_TAILSCALE_HOSTNAME=your-machine.tailnet.ts.net
# TAILSCALE_BIN=tailscale

# Muximod configuration that is not derived from the selected environment.
# The bundled Capacitor client always uses the fixed first-party origin
# capacitor://localhost; muximod allows it automatically. Do not add that
# origin to MUXIMOD_ALLOWED_ORIGINS. Add only HTTP(S) origins for a browser or
# a Capacitor Local build that loads the Web runtime remotely.
# MUXIMOD_ALLOWED_ORIGINS=https://your-machine.tailnet.ts.net:8449
# MUXIMOD_WORKSPACE_ROOTS=/Users/you/work:/Users/you/projects
# MUXIMOD_TMUX_SOCKET=/Users/you/.local/state/muximo/tmux.sock
# MUXIMOD_MUXIMO_COMMAND=/absolute/path/to/muximo
# MUXIMO_LOG_LEVEL=info
# The muximod log is always derived as <state-root>/<environment>/muximod/muximod.log.

# Pairing accepts an explicit URL as a one-shot override:
# muximo --env local pair --muximod-base-url https://your-machine.tailnet.ts.net:8444
