# Recommended staging profile recipe without a Web runtime. `mise profile`
# copies this recipe into an ignored `.env.<name>` file and fills in the
# selected connection details. Use the bundled Capacitor client for this
# profile; its first-party origin is allowed by muximod automatically.
MUXIMO_SCHEMA_MODE=migrate
MUXIMO_MUXIMOD_PORT=4327
MUXIMO_MUXIMOD_SERVE_PORT=8454
