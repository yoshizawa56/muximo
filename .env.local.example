# Recommended local profile recipe with a Web runtime. `mise profile` copies
# this recipe into an ignored `.env.<name>` file and fills in the selected
# connection details. Choose `none` for a daemon-only profile, or choose
# `capacitor` to optionally generate the iOS Local configuration.
MUXIMO_SCHEMA_MODE=push
MUXIMO_MUXIMOD_PORT=4317
MUXIMO_MUXIMOD_SERVE_PORT=8444
MUXIMO_WEB_PORT=5227
MUXIMO_WEB_SERVE_PORT=8449
MUXIMOD_ALLOWED_ORIGINS=http://127.0.0.1:5227,http://localhost:5227
