{
  "name": "@muximo/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "web": "cli.ts"
  },
  "scripts": {
    "build": "node ./node_modules/vite/bin/vite.js build",
    "cap:sync": "bun run build && cap sync ios",
    "cap:open": "cap open ios",
    "cap:run": "cap run ios --scheme Local",
    "build-storybook": "node ./node_modules/storybook/dist/bin/dispatcher.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "storybook": "node ./node_modules/storybook/dist/bin/dispatcher.js dev --host 0.0.0.0 -p 6006",
    "test": "node ./node_modules/vitest/vitest.mjs run src",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/preferences": "8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@muximo/contract": "workspace:*",
    "@muximo/infrastructure": "workspace:*",
    "@muximo/profile": "workspace:*",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/tanstack-query": "^1.15.0",
    "@tanstack/query-core": "^5.102.5",
    "@tanstack/react-query": "^5.102.5",
    "@tanstack/react-router": "^1.170.32",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@zxing/browser": "^0.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@muximo/test-support": "workspace:*",
    "@types/node": "^26.3.0",
    "@orpc/server": "^1.15.0",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
